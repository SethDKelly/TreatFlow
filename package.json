{
  "name": "treatflow",
  "version": "0.0.0",
  "private": true,
  "description": "TreatFlow local-only synthetic Observation app (014-B foundation + 016-B/C actions). No cloud, real data, or deployment.",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint .",
    "test": "vitest run && npm run test:shadow && npm run test:review-events && npm run test:review-provider && npm run test:ci-evidence",
    "test:watch": "vitest",
    "test:shadow": "node --test tools/shadow/*.test.mjs",
    "test:review-events": "node --test tools/review-events/*.test.mjs",
    "test:review-provider": "node --test tools/review-provider/*.test.mjs",
    "test:ci-evidence": "node --test scripts/verify-merge-evidence.test.mjs scripts/verify-merge-evidence.adversarial.test.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "vitest": "^5.0.5"
  }
}
